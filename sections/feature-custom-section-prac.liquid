{{ 'feature-custom-section-prac.css' | asset_url | stylesheet_tag }}
<div
  class="feature-section-wrapper"
  style="padding: 40px; text-align: center; font-family: sans-serif; background-color: #fcfcfc;"
>
  <!-- 1. Section Level Headings -->
  <div class="feature-section-header" style="margin-bottom: 40px;">
    <h1 style="margin: 0 0 10px 0; color: #222;">{{ section.settings.heading }}</h1>
    <h3 style="margin: 0; color: #666; font-weight: 400;">{{ section.settings.sub_heading }}</h3>
  </div>
  {% assign selected_product = all_products[section.settings.featured_product] %}

  <div class="" style="margin-bottom: 40px;">
    {% if selected_product != blank %}
      <h2>Selected Product: {{ selected_product.title }}</h2>
      <p>Price: {{ selected_product.price | money }}</p>
    {% endif %}
  </div>

  <!-- 2. Dynamic Blocks Rendering Area -->
  <div
    class="feature-blocks-grid"
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; max-width: 1200px; margin: 0 auto;"
  >
    {% comment %} Hum merchant ke add kiye hue har block par loop chala rahe hain {% endcomment %}
    {% for block in section.blocks %}
      {% comment %} block.shopify_attributes lagana zaroori ha taake merchant jab panel me card par click kare to customizer foran us block par jump kare {% endcomment %}
      <div
        class="feature-card"
        {{ block.shopify_attributes }}
        style="border: 1px solid #e1e1e1; padding: 20px; border-radius: 8px; background: #fff; box-shadow: 0 4px 6px rgba(0,0,0,0.02); text-align: center;"
      >
        <!-- Block Icon -->
        <div
          class="feature-icon-wrapper"
          style="
            --desktop-icon-size: {{ block.settings.desktop_icon_size }}px;
            --mobile-icon-size: {{ block.settings.mobile_icon_size }}px;
          "
        >
          {% if block.settings.feature_icon != blank %}
            <img
              class="feature-card-icon"
              src="{{ block.settings.feature_icon | image_url: width: 40 }}"
              alt="{{ block.settings.feature_title | escape }}"
              width="40"
              height="{{ 40 | divided_by: block.settings.feature_icon.aspect_ratio | round }}"
              style="object-fit: contain;"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>

        <!-- Block Title -->
        <h4 style="margin: 10px 0; font-size: 18px; color: #333;">
          {{ block.settings.feature_title | default: 'Feature Title' }}
        </h4>

        <!-- Block Description -->
        <p style="margin: 0; font-size: 14px; color: #666; line-height: 1.5;">
          {{ block.settings.feature_desc }}
        </p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Feature Section Custom",
  "presets": [
    {
      "name": "Feature Section Custom",
      "settings": {
        "heading": "Our Core Features",
        "sub_heading": "Why intelligent merchants choose our system"
      },
      "blocks": [{ "type": "feature_item" }, { "type": "feature_item" }, { "type": "feature_item" }]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Feature Heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Section Sub Heading",
      "default": "Set Sub Heading Description"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Select Hero Product",
      "info": "Choose a product to display in the hero section"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_icon",
          "label": "Feature Icon / Image"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "Fast Shipping"
        },
        {
          "type": "textarea",
          "id": "feature_desc",
          "label": "Feature Description",
          "default": "Get your products delivered inside 24 hours globally."
        },
        {
          "type": "range",
          "id": "desktop_icon_size",
          "min": 20,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Desktop Icon Size",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_icon_size",
          "min": 20,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Mobile Icon Size",
          "default": 40
        }
      ]
    }
  ]
}
{% endschema %}
