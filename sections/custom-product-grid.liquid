{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card-actions.js' | asset_url }}" defer></script>

<section
  id="custom-product-grid-{{ section.id }}"
  class="custom-product-grid page-width"
  style="--cards-per-row: {{ section.settings.columns }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="custom-product-grid__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="custom-product-grid__list" role="list">
    {%- for product in collections.all.products limit: section.settings.product_limit -%}
      <li class="custom-product-grid__item">
        {%- render 'product-card', product: product -%}
      </li>
    {%- else -%}
      <li>
        <p>{{ 'sections.featured_collection.empty' | t }}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Our Products"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products to show",
      "min": 4,
      "max": 20,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
