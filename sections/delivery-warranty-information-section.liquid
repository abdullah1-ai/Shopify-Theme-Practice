{% style %}
  .delivery-warranty-{{ section.id }} {
    padding: 40px 20px;
  }
  .delivery-warranty-{{ section.id }} .section-heading {
    text-align: center;
    margin-bottom: 30px;
  }

  .delivery-warranty-{{ section.id }} .blocks-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  /* Har block ke liye dynamic CSS generation */
  {% for block in section.blocks %}
    .block-{{ block.id }} {
      text-align: {{ block.settings.alignment }};
    }

    .block-{{ block.id }} img,
    .block-{{ block.id }} svg {
      max-width: 100%;
      height: auto;
      display: inline-block;
      border-radius: {{ block.settings.image_radius }}px;
      margin-bottom: 15px;
    }

    .block-{{ block.id }} .feature-title {
      margin-bottom: 10px;
      font-size: 1.25em;
    }

    .block-{{ block.id }} .feature-description {
      color: inherit;
    }
  {% endfor %}
{% endstyle %}

<delivery-warranty-information-section class="delivery-warranty-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="blocks-container">
      {% for block in section.blocks %}
        <div class="feature-block block-{{ block.id }}" {{ block.shopify_attributes }}>
          {% if block.settings.icon_image %}
            <img
              src="{{ block.settings.icon_image | image_url: width: 200 }}"
              alt="{{ block.settings.icon_image.alt | escape }}"
              width="200"
              height="200"
              loading="lazy"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}

          {% if block.settings.title_feature != blank %}
            <h3 class="feature-title">{{ block.settings.title_feature }}</h3>
          {% endif %}

          {% if block.settings.description_feature != blank %}
            <div class="feature-description rte">
              {{ block.settings.description_feature }}
              <p>
                {% render 'price', product: product %}
              </p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</delivery-warranty-information-section>

{% schema %}
{
  "name": "Delivery & Warranty",
  "presets": [
    {
      "name": "Delivery & Warranty",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery & Warranty information section",
      "info": "Heading of section"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Image",
          "info": "Image icon"
        },
        {
          "type": "range",
          "id": "image_radius",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Image Border Radius",
          "default": 0
        },
        {
          "type": "text",
          "id": "title_feature",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "description_feature",
          "label": "Description",
          "default": "<p>Enter Description here</p>"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ]
}
{% endschema %}
